in-left:auto}.fc-head-meta .fsize{font-size:12px;color:var(--gray-mid,#8a97a5)}.file-card-size{font-size:12px;color:var(--gray-mid);flex-shrink:0}.file-folder-list{border-top:1px dashed var(--border);padding:8px 12px}.file-folder-item{display:flex;align-items:center;gap:8px;padding:4px 0;font-size:14px;border-bottom:1px solid var(--border-soft,var(--border))}.file-folder-item:last-child{border-bottom:none}.file-folder-item .fname{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.file-folder-item .fsize{font-size:12px;color:var(--gray-mid);flex-shrink:0}.file-folder-item.oversize .fname{color:var(--red-ink,var(--red))}.file-folder-item.oversize .fsize{color:var(--red-ink,var(--red));font-weight:600}.file-folder-item.is-folder{display:block;padding:4px 0}.file-folder-item .fc-row-head{display:flex;align-items:center;gap:8px}.file-folder-item .fmeta{font-size:12px;color:var(--text-faint);flex-shrink:0}.file-folder-item .file-folder-list.fc-kids{margin:4px 0 0 12px;padding-left:10px;border-left:2px solid var(--border-soft,var(--border));border-top:none}.fc-arrow{width:24px;height:24px;border:none;background:transparent;color:var(--blue-ink,var(--blue1));cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;flex-shrink:0;line-height:0}.fc-dl{flex-shrink:0;border:1px solid var(--blue2);background:var(--card-bg);color:var(--blue-ink,var(--blue1));border-radius:var(--r-pill);padding:2px 10px;font-size:12px;cursor:pointer}.fc-dl:hover{background:var(--blue1);color:var(--text-on-brand,#fff)}.file-folder-open{padding:8px 12px;text-align:center}.file-folder-open a{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;border-radius:var(--r-m);border:1px solid var(--blue1);background:var(--blue1);color:var(--text-on-brand,#fff);font-size:14px;text-decoration:none}@media (max-width:390px){.file-card-header{padding:8px 8px;font-size:14px;gap:4px}.file-folder-item{gap:4px;font-size:12px}.file-folder-bulk button,.file-folder-open a{padding:4px 8px;font-size:12px}}.search-input:focus-visible,.search-input:focus{box-shadow:0 0 0 3px rgba(var(--blue1-rgb,30,136,229),.25)}.admin-search input:focus-visible{box-shadow:0 0 0 3px rgba(var(--blue1-rgb,30,136,229),.25)}.product-card:hover .card-img{transform:scale(1.05)}.ann-tab:hover{border-color:var(--blue-ink,var(--blue1));color:var(--blue-ink,var(--blue1));background:var(--hover-bg);transform:translateY(-1px)}.ann-modal .ann-title:hover{color:var(--blue-ink,var(--blue1))}.cat-toggle:hover{color:var(--blue-ink,var(--blue1))}.sub-cat-toggle:hover{color:var(--blue-ink,var(--blue1))}.category-tag:active,.variant-tab:active,.ann-tab:active{transform:scale(0.94);opacity:.8;transition-duration:var(--dur-fast)}.product-card{position:relative}#modalBox:focus,#modalBox:focus-visible{outline:none !important}.product-card::after{content:'';position:absolute;inset:0;border-radius:inherit;box-shadow:0 8px 24px rgba(var(--shadow-card-blue-rgb,30,80,140),.18);opacity:0;transition:opacity var(--dur-fast) var(--ease-out);pointer-events:none}.product-card:hover::after{opacity:1}@media (min-width:601px) and (max-width:1024px){.product-grid{grid-template-columns:repeat(3,1fr) !important;gap:12px;padding:12px}.product-grid.list-view{grid-template-columns:1fr !important}.toolbar,.filter-bar,.topbar-inner{flex-wrap:wrap;row-gap:8px}.category-bar,.cat-bar{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch}}@media (max-height:520px){.topbar{position:static !important}.product-grid{gap:8px;padding:8px}.modal-box{max-height:96vh}.page-title{margin-top:4px !important;margin-bottom:12px !important}}.modal-box.modal-swap{animation:modalSwap var(--dur-mid) var(--ease-out)}@keyframes modalSwap{from{opacity:0.4;transform:translateX(16px)}to{opacity:1;transform:none}}@media (min-width:1600px){.topbar-inner,.category-bar-wrap,.sub-category-bar-wrap,.recent-bar-wrap,.product-grid{max-width:1500px}}.product-card .card-img.media-fail,.thumb.media-fail,img.media-fail{opacity:1 !important;animation:none !important;transition:none !important}.topbar-actions .tab,.ann-tab,.ann-title{position:relative}.card-img{background:var(--bg-light,#eef4fb)}.product-grid.list-view .card-img{background:var(--bg-light,#eef4fb)}html.shop-preview,html.shop-preview body{background:#000 !important}/* v647（老板 11-18 第 2 条：预览里点「咨询客服」没反应）：预览模式只留资源弹窗，白名单里漏了客服弹窗——
   #kfMask 是 body 直接子节点，被这条 display:none!important 一起吃掉了，点下去什么都不弹。
   客服弹窗必须放行（它在 iframe 里 z-index 10001，永远压住 #modalMask 的 2000）。 */
html.shop-preview body>*:not(#modalMask):not(#lightboxMask):not(#kfMask):not(#kfFallback):not(.toast-wrap):not(#toastWrap){display:none !important}html.shop-preview #modalBox,html.shop-preview #modalBox:focus,html.shop-preview #modalBox:focus-visible{outline:none !important;outline-width:0 !important;border-radius:12px}html.shop-ann-preview,html.shop-ann-preview body{background:transparent !important}html.shop-ann-preview body>*:not(#annModal):not(.toast-wrap):not(#toastWrap){display:none !important}html.shop-ann-preview #annModal{background:transparent !important}html.shop-ann-preview #annModal .modal-close-x,html.shop-ann-preview #annModal .ann-ok{display:none !important}.category-tag{min-height:40px}.topbar .tab,.view-btn{min-height:40px}.cat-toggle,.sub-cat-toggle{width:32px;height:32px}@media (max-width:600px){.topbar .tab{min-width:40px}.view-btn{min-width:40px}}@media (max-width:600px){.ann-tab{height:40px}.ann-modal .ann-title{min-height:40px;display:flex;align-items:center}}@media (max-width:600px){.recent-chip{min-height:40px}}:root{--dur-arrow:0.26s;--ease-arrow:cubic-bezier(.34,1.18,.64,1)}.cat-toggle .toggle-arrow,.sub-cat-toggle .toggle-arrow,.recent-toggle .toggle-arrow,.fc-arrow .toggle-arrow{transition:transform var(--dur-tri) var(--ease-tri) !important}.ann-tabs-wrap{position:relative;padding:0 4px}/* v633（老板 11-16）：与一级分类同一套——默认一行横滑（可左右拖），点三角变多行全显示。
   原来默认换行铺满 + 居中，公告一多就占掉半屏。 */
.ann-tabs{display:flex;flex-wrap:nowrap;justify-content:flex-start;align-items:center;max-height:none;overflow-x:auto;overflow-y:hidden;padding:2px 32px 8px 4px;gap:8px;margin-bottom:12px;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scrollbar-width:none;transition:max-height var(--dur-arrow) var(--ease-arrow)}
.ann-tabs::-webkit-scrollbar{display:none}.ann-tabs.is-clipped{overflow-x:auto;overflow-y:hidden}.ann-tabs.is-open{flex-wrap:wrap;overflow:visible}.ann-tabs-fold{position:absolute;right:2px;top:3px;width:24px;height:24px;border:none;background:transparent;color:var(--blue-ink,var(--blue1));padding:0;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;z-index:2}.ann-tabs-fold .toggle-arrow{width:18px;height:18px;transform:rotate(-90deg)}.ann-tabs-fold.open .toggle-arrow{transform:rotate(0deg)}.ann-modal .ann-body.is-center{text-align:center}.ann-modal .ann-body.is-center p{margin-left:auto;margin-right:auto}.recent-chip{display:inline-block;padding:3px 12px;min-height:22px;max-width:none;border:1px solid var(--border);background:var(--bg-light);color:var(--text-light);border-radius:var(--r-pill);font-size:12px;white-space:nowrap;transition:transform var(--dur-mid) var(--ease-out),opacity var(--dur-mid) ease,background var(--dur-mid) ease,color var(--dur-mid) ease,box-shadow var(--dur-mid) ease}.recent-chip:hover{background:var(--card-bg);color:var(--link-blue,var(--blue-ink-strong));border-color:var(--blue2)}@media (max-width:600px){.recent-chip{min-height:22px}}.category-bar{max-height:56px;overflow-y:hidden;transition:max-height var(--dur-arrow) var(--ease-arrow)}.category-bar.expanded{max-height:360px;overflow:hidden}.sub-category-bar{max-height:36px;overflow-y:hidden;transition:max-height var(--dur-arrow) var(--ease-arrow)}.sub-category-bar.expanded{max-height:260px;overflow:hidden}.recent-bar{transition:max-height var(--dur-arrow) var(--ease-arrow)}@media (max-width:600px){.ann-tabs{max-height:none}.ann-tabs-fold{top:10px}}:root{--dur-tri:0.34s;--ease-tri:cubic-bezier(.34,1.56,.64,1)}.toggle-arrow,.cpd-arrow,.set-caret{transition:transform var(--dur-tri) var(--ease-tri) !important;transform-origin:50% 50%}.ann-tabs-fold[hidden],.recent-toggle[hidden],.cat-toggle[hidden]{display:none !important}.category-bar-wrap{position:sticky;top:var(--topbar-h,60px);z-index:90;display:flex;align-items:stretch;max-width:1200px;margin:0 auto;background:var(--card-bg);border-radius:14px;box-shadow:var(--shadow-pop);overflow:hidden}.category-bar{position:static;flex:1 1 auto;min-width:0;background:transparent;box-shadow:none;border-radius:0}.cat-toggle{position:static;flex:0 0 44px;width:44px;height:auto;min-height:44px;border:none;background:var(--card-bg);border-radius:0;padding:0;display:flex;align-items:center;justify-content:center;color:var(--blue-ink,var(--blue1));cursor:pointer}.sub-category-bar-wrap,.recent-bar-wrap{display:flex;align-items:center}.sub-category-bar,.recent-bar{flex:1 1 auto;min-width:0}.sub-cat-toggle,.recent-toggle{position:static;flex:0 0 36px;width:36px;height:36px;min-width:36px;min-height:36px;margin-left:2px;background:transparent;border:none;display:flex;align-items:center;justify-content:center;color:var(--blue-ink,var(--blue1));cursor:pointer}@media (max-width:600px){.cat-toggle{flex-basis:40px;width:40px;min-height:40px}}.sub-category-bar{max-height:none}.category-bar,.sub-category-bar,.recent-bar{-webkit-mask-image:linear-gradient(to right,#000 calc(100% - 16px),transparent 100%);mask-image:linear-gradient(to right,#000 calc(100% - 16px),transparent 100%)}@media (min-width:1600px){.category-bar-wrap{max-width:1500px}}.category-bar{padding-left:0;padding-right:0}.sub-category-bar{padding:6px 0 6px}.product-grid{padding-top:12px}.product-grid.list-view{gap:12px}@media (min-width:601px){.product-grid.list-view .product-card{position:relative}.product-grid.list-view .card-body{padding-right:132px}.product-grid.list-view .card-price-row{position:absolute;right:20px;top:50%;transform:translateY(-50%);margin:0}.product-grid.list-view .card-price{font-size:17px;letter-spacing:0.4px}}.product-grid.list-view .card-title{min-height:0}@media (max-width:600px){.product-grid{gap:12px}}

/* ===== v631N（老板 04:14）：排序控件 =====
   放回分类条右侧，不另占一行。形态「当前类型 + ⇅」：
   点文字弹出类型（复用后台 .cat-picker-panel / .cp-item），点 ⇅ 切升/降序。
   分类条右侧留出与控件等宽的内边距，保证最后一个分类能完整滚出来、不被压住。 */
/* v631Q（老板 05:29）：把「当前类型 + ⇅」框成一个整体——一个圆角边框把它们包住，
   中间只留一个空格的间距；文字和箭头仍是两个独立可点区域；整框在分类条里上下居中。
   高度 42 = 边框 1×2 + 内容 40，保证里面的可点区域仍有 40px（前台触控门槛）。 */
.category-bar-wrap .category-bar{margin-right:86px}
.sort-ctrl{position:absolute;right:52px;top:7px;z-index:96;display:flex;align-items:center;
  height:42px;box-sizing:border-box;background:var(--card-bg,#fff);
  border:1px solid var(--border);border-radius:10px;
  transition:border-color var(--dur-fast,.15s) ease,box-shadow var(--dur-fast,.15s) ease}
.sort-ctrl:hover{border-color:var(--border)}
.sort-ctrl .cat-picker{display:flex;align-items:center;height:100%}
.sort-ctrl .cat-picker-display.sort-type{display:flex;align-items:center;justify-content:center;
  height:40px;min-width:40px;padding:0 0 0 12px;border:none;background:transparent;box-shadow:none;
  border-radius:10px 0 0 10px;font-size:14px;color:var(--text,#222);cursor:pointer;
  transition:color var(--dur-fast,.15s) ease}
.sort-ctrl .cat-picker-display.sort-type:hover{color:var(--blue1)}
.sort-ctrl .cat-picker.open .cat-picker-display.sort-type{color:var(--blue1);box-shadow:none}
.sort-ctrl .cat-picker-display.sort-type:focus-visible{outline:none}
.sort-ctrl:focus-within{border-color:var(--blue1);box-shadow:0 0 0 3px rgba(25,118,210,.15)}
/* v633（老板 11-16）：默认态与右侧箭头同一个颜色，选中非默认档才用系统蓝。 */
/* v633：与箭头同一色系，但文字必须过 WCAG（#8fa0b2 只有 2.68:1，需要 4.5）——
   所以文字用 --text-faint(#647079，约 4.9:1)，箭头仍用 --ink-sort-idle。视觉上同色系、深浅一档。 */
.cpd-text{color:var(--text-faint);font-weight:600;white-space:nowrap;line-height:1;font-size:14px}
.cpd-text.is-picked{color:var(--blue-ink,var(--blue1))}
.sort-dir{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;
  width:40px;height:40px;padding:0;border:none;background:transparent;color:var(--blue1);
  cursor:pointer;border-radius:0 9px 9px 0;transition:background var(--dur-fast,.15s) ease}
.sort-dir:hover{background:transparent}
.sort-dir:focus-visible{outline:none}
.sort-dir .sd-ico{width:24px;height:24px;display:block;margin-left:-10px}
/* 两根箭头各自点亮：asc=上亮，desc=下亮，none（默认档）=都不亮 */
.sort-dir .sd-up,.sort-dir .sd-dn{opacity:.3;transition:opacity var(--dur-fast,.15s) ease}
.sort-dir.asc .sd-up{opacity:1}
.sort-dir.desc .sd-dn{opacity:1}
.sort-dir.none{color:var(--ink-sort-idle)}
.sort-dir.none .sd-up,.sort-dir.none .sd-dn{opacity:.45}
/* 悬停整根一起稍微提亮（不暗示两根分开点） */
.sort-dir:hover .sd-ico{opacity:.92}
/* 类型面板（复用后台下拉底座，这里只补紧凑尺寸） */

.sort-ctrl .cat-picker-panel .cp-item{padding:8px 10px;font-size:14px;white-space:nowrap}
@media (max-width:600px){
  .category-bar-wrap .category-bar{margin-right:92px}
  .sort-ctrl{right:48px}
  .sort-ctrl .cat-picker-display.sort-type{font-size:13px;padding:0 4px 0 9px}
}

/* 下拉底座：与后台 .cat-picker-panel 逐条对齐（admin.css 原值），
   动画只有「淡入/淡出 + 6px 位移」两件事——max-height 固定 600px 不参与变化。
   v631T（老板 08:31）：之前这里把 max-height 从 0 变到 320，收起时面板是"卷上去"的，
   和系统下拉的淡出效果不一致；且 JS 收起时立刻清了 top/left，面板会在淡出中途跳回原位。 */
.cat-picker-panel{display:block;position:fixed;z-index:6002;opacity:0;transform:translateY(-6px);pointer-events:none;
  background:var(--card-bg,#fff);border:1px solid var(--border);border-radius:10px;
  box-shadow:0 12px 32px rgba(0,0,0,.18);padding:4px;
  max-height:600px;overflow-y:auto;overscroll-behavior:auto;
  transition:opacity var(--dur-mid,.22s) var(--ease-out,cubic-bezier(.22,1,.36,1)),transform var(--dur-mid,.22s) var(--ease-out,cubic-bezier(.22,1,.36,1)),max-height var(--dur-mid,.22s) var(--ease-out,cubic-bezier(.22,1,.36,1))}
.cat-picker-panel.open{opacity:1;transform:none;pointer-events:auto;}
.cat-picker-panel .cp-item{display:flex;align-items:center;gap:6px;padding:9px 10px;border-radius:8px;
  cursor:pointer;font-size:14px;color:var(--text,#222);transition:background .12s ease}
.cat-picker-panel .cp-item:focus-visible{outline:2px solid var(--blue1);outline-offset:-2px}
.cat-picker-panel .cp-item.selected{background:var(--blue1);color:var(--text-on-brand,#fff);font-weight:600}

/* ============ v649 · 垂直居中统一层（老板 11-18 硬要求：该上下居中的都上下居中） ============ */
/* ① 详情弹窗标题行：原来 align-items:flex-start，且标题自带 margin-bottom:16px。
   390 下标题折两行，那 16px 把行高撑到 72、标题被顶到上半、价格贴在行顶 —— 实测偏 7.75px，
   是全站唯一超 1px 的「行」。现在：行内居中 + 行内的标题清掉那条外边距（外边距只给独立标题用）。 */
.modal-title-row{align-items:center;margin-bottom:24px} /* 24 = 原来的 标题16 + 行8，间距节奏不变 */
.modal-title-row>.modal-title{margin-top:0;margin-bottom:0}
/* ② 最近浏览标题行：子元素高度不等，flex-start 下偏 0.75px → 统一居中。 */
#recentBar,.recent-bar{align-items:center}
/* ③ 水平排列的控件组统一垂直居中（今天实测 0.00px，写显式值防同类回归，见规范 18.9 #1）。 */
.category-bar,.sub-category-bar,.topbar-actions,.sort-ctrl,.pager,
.modal-footer,.kf-actions,.ann-tabs,.view-switch,.variant-tabs,.pc-actions,
.cat-picker-display,.cpd-arrow{align-items:center}

/* v654：系统维护条（503 / DB_BUSY 专用）。与「暂无资源」空态必须在视觉上分开——
   空态是灰色立方体 + 「暂无资源」，维护态是琥珀条 + 警示号 + 「系统维护中」。 */
.maint-bar{position:sticky;top:var(--topbar-h,60px);z-index:99;background:#b26a00;color:#fff;text-align:center;font-size:12px;line-height:18px;padding:6px 12px;letter-spacing:.5px;box-shadow:0 2px 8px rgba(0,0,0,.12)}
.empty-tip.is-maint .empty-icon{display:none}
.empty-tip.is-maint .empty-title{color:var(--warn-ink,#b26a00);font-weight:600}
.empty-tip.is-maint .empty-title::before{content:'\26A0\FE0E  '}
